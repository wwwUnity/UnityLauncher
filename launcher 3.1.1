def generate_logo():
    if LOGO_FILE.exists():
        return
    try:
        size = 256
        img = Image.new("RGBA", (size, size), (0, 0, 0, 0))
        draw = ImageDraw.Draw(img)
        for i in range(size // 2, 0, -1):
            ratio = i / (size // 2)
            r, g, b = int(123 * (1 - ratio) + 154 * ratio), int(92 * (1 - ratio) + 128 * ratio), 255
            draw.ellipse([size//2 - i, size//2 - i, size//2 + i, size//2 + i], fill=(r, g, b, 255))
        try:
            font = ImageFont.truetype("arial.ttf", 140)
        except Exception:
            font = ImageFont.load_default()
        draw.text((size//2, size//2 - 10), "U", fill="white", font=font, anchor="mm")
        img.save(LOGO_FILE)
    except Exception:
        pass


class UnityLauncher(ctk.CTk):
    def __init__(self):
        super().__init__()
        self.title(f"{APP_NAME} v{VERSION}")
        self.geometry("1200x750")
        self.minsize(1100, 700)
        self.configure(fg_color=BG_COLOR)

        Path(MC_DIR).mkdir(parents=True, exist_ok=True)
        self.settings = self._load_json(SETTINGS_FILE, {"nickname": "", "version": "1.20.4", "theme": "Фиолетовая", "custom_accent": None, "registered": False, "email": ""})
        self.data = self._load_json(DATA_FILE, {"friends": [], "achievements": [], "coins": 0, "owned_skins": []})
        
        self._apply_theme_from_settings()
        self._bg_label = None
        self._bg_image = None
        self._page_builders = {}
        self._built_pages = {}
        self._all_versions_cache = [] 
        self._selected_loader = "Vanilla"
        self._email_code = None
        self._email_target = None

        try:
            generate_logo()
            self._show_registration()
        except Exception:
            self._log_error()

    def _load_json(self, path, default):
        if path.exists():
            try:
                return json.loads(path.read_text("utf-8"))
            except Exception:
                pass
        return default

    def _save_json(self, path, data):
        path.write_text(json.dumps(data, indent=2, ensure_ascii=False), "utf-8")

    def _log_error(self):
        try:
            with open(ERROR_LOG, "a", encoding="utf-8") as f:
                f.write("\n===== " + str(Path.cwd()) + " =====\n")
                f.write(traceback.format_exc())
        except Exception:
            pass
        traceback.print_exc()

