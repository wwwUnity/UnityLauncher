    # ---------- ОКНО ВЫБОРА ВЕРСИЙ ----------
    def _open_version_selector(self):
        win = ctk.CTkToplevel(self)
        win.title("Версии Minecraft")
        win.geometry("550x650")
        win.configure(fg_color=BG_COLOR)
        win.attributes("-topmost", True)

        ctk.CTkLabel(win, text="Выберите версию", font=ctk.CTkFont(size=18, weight="bold"), text_color=TEXT).pack(pady=10)
        
        search_var = ctk.StringVar()
        ctk.CTkEntry(win, placeholder_text="Поиск...", textvariable=search_var, height=40).pack(fill="x", padx=20, pady=10)

        scroll = ctk.CTkScrollableFrame(win, fg_color=PANEL_COLOR, corner_radius=12)
        scroll.pack(fill="both", expand=True, padx=20, pady=(0, 20))

        if not self._all_versions_cache:
            ctk.CTkLabel(scroll, text="Загрузка версий...", text_color=SUBTEXT).pack(pady=20)
            return

        def get_approx_size(ver):
            if ver.startswith("1.20"): return "~300 МБ"
            if ver.startswith("1.19"): return "~280 МБ"
            if ver.startswith("1.18"): return "~250 МБ"
            if ver.startswith("1.16"): return "~200 МБ"
            return "~150 МБ"

        all_buttons = []
        for version in self._all_versions_cache:
            size = get_approx_size(version)
            text = f"{version}  ({size})"
            btn = ctk.CTkButton(scroll, text=text, anchor="w", height=35, corner_radius=8, fg_color="transparent", hover_color="#22222e", text_color=TEXT, command=lambda v=version: self._select_version(v, win))
            btn.pack(fill="x", pady=1)
            all_buttons.append((version, btn))

        def filter_versions(*args):
            query = search_var.get().lower()
            for v_name, btn in all_buttons:
                if query in v_name.lower():
                    btn.pack(fill="x", pady=1)
                else:
                    btn.pack_forget()

        search_var.trace_add("write", filter_versions)

    def _select_version(self, version, window):
        self.settings["version"] = version
        self._save_json(SETTINGS_FILE, self.settings)
        self.version_button.configure(text=f"Выбрано: {version}")
        window.destroy()

    # ---------- ДЕЙСТВИЯ ----------
    def _choose_background(self):
        try:
            path = filedialog.askopenfilename(title="Выберите картинку", filetypes=[("Изображения", "*.png *.jpg *.jpeg")])
            if not path:
                return
            img = Image.open(path).convert("RGBA")
            img.save(BG_FILE)
            self._apply_background()
        except Exception:
            pass

    def _open_themes(self):
        win = ctk.CTkToplevel(self)
        win.title("Темы")
        win.geometry("380x450")
        win.configure(fg_color=BG_COLOR)
        win.attributes("-topmost", True)
        ctk.CTkLabel(win, text="Выберите тему", font=ctk.CTkFont(size=16, weight="bold"), text_color=TEXT).pack(pady=15)
        for name, color in THEMES.items():
            ctk.CTkButton(win, text=name, height=38, corner_radius=10, fg_color=color, hover_color=self._lighten(color), command=lambda n=name: self._set_theme(n, win)).pack(fill="x", padx=30, pady=4)
        
        ctk.CTkButton(win, text="🎨 Своя палитра", height=42, corner_radius=10, fg_color=ACCENT, hover_color=ACCENT_HOVER, command=self._pick_custom_color).pack(fill="x", padx=30, pady=15)

    def _set_theme(self, name, win):
        self.settings["theme"] = name
        self.settings["custom_accent"] = None
        self._save_json(SETTINGS_FILE, self.settings)
        win.destroy()

    def _pick_custom_color(self):
        color = colorchooser.askcolor(title="Выберите акцентный цвет")
        if color and color[1]:
            self.settings["custom_accent"] = color[1]
            self._save_json(SETTINGS_FILE, self.settings)
            global ACCENT, ACCENT_HOVER
            ACCENT = color[1]
            ACCENT_HOVER = self._lighten(ACCENT, 0.2)
            self._show_page("home")

    # ---------- ЗАГРУЗКА ВЕРСИЙ ----------
    def _load_versions_async(self):
        threading.Thread(target=self._load_versions, daemon=True).start()

    def _load_versions(self):
        try:
            all_versions = []
            for v in minecraft_launcher_lib.utils.get_version_list():
                all_versions.append(v["id"])
            all_versions.sort(reverse=True)
            self._all_versions_cache = all_versions

            def update_ui():
                if self.winfo_exists() and hasattr(self, 'status'):
                    self.status.configure(text=f"Готов (найдено {len(all_versions)} версий)")
                    if self.settings.get("version") not in all_versions and all_versions:
                        self.settings["version"] = all_versions[0]
                        self._save_json(SETTINGS_FILE, self.settings)
                        if hasattr(self, 'version_button'):
                            self.version_button.configure(text=f"Выбрано: {all_versions[0]}")
            self.after(0, update_ui)
        except Exception as e:
            self.after(0, lambda: self.status.configure(text=f"Ошибка: {e}"))

    def _set_progress(self, value, text=None):
        self.after(0, lambda: self.progress.set(value))
        if text:
            self.after(0, lambda: self.status.configure(text=text))

    # ---------- ЗАПУСК ----------
    def _play(self):
        nick = self.nick_entry.get().strip()
        selected = self.settings.get("version", "")
        
        if not (3 <= len(nick) <= 16):
            self.status.configure(text="⚠ Ник 3–16 символов")
            return
        if not selected:
            self.status.configure(text="⚠ Выберите версию")
            return
        
        self.settings["nickname"] = nick
        self._save_json(SETTINGS_FILE, self.settings)
        self.play_btn.configure(state="disabled", text="ЗАПУСК...")
        self.progress.configure(mode="indeterminate")
        self.progress.start()
        threading.Thread(target=self._launch, args=(nick, selected), daemon=True).start()

    def _launch(self, nick, selected):
        try:
            loader = self._selected_loader
            installed = selected
            
            def update_status(text):
                self._set_progress(0.5, text)

            callback_dict = {
                "setStatus": update_status,
                "setProgress": lambda p: self.after(0, lambda: self.progress.set(p / 100)),
                "setMax": lambda m: None
            }

            if loader == "Forge":
                loader_obj = minecraft_launcher_lib.mod_loader.get_mod_loader("forge")
                installed = loader_obj.install(selected, MC_DIR, callback=callback_dict)
            elif loader == "NeoForge":
                loader_obj = minecraft_launcher_lib.mod_loader.get_mod_loader("neoforge")
                installed = loader_obj.install(selected, MC_DIR, callback=callback_dict)
            elif loader == "Fabric":
                loader_obj = minecraft_launcher_lib.mod_loader.get_mod_loader("fabric")
                installed = loader_obj.install(selected, MC_DIR, callback=callback_dict)
            else:
                minecraft_launcher_lib.install.install_minecraft_version(selected, MC_DIR, callback=callback_dict)
                installed = selected

            self.after(0, lambda: self.progress.stop())
            self.after(0, lambda: self.progress.configure(mode="determinate"))
            self._set_progress(0.95, "Запуск...")
            
            cmd = minecraft_launcher_lib.command.get_minecraft_command(installed, MC_DIR, {"username": nick, "uuid": "", "token": ""})

            kwargs = {"cwd": MC_DIR}
            if sys.platform == "win32":
                kwargs["creationflags"] = subprocess.CREATE_NEW_PROCESS_GROUP | subprocess.DETACHED_PROCESS
                kwargs["stdin"] = subprocess.DEVNULL
                kwargs["stdout"] = subprocess.DEVNULL
                kwargs["stderr"] = subprocess.DEVNULL
            else:
                kwargs["start_new_session"] = True
                
            subprocess.Popen(cmd, **kwargs)
            
            if "Первый запуск" not in self.data["achievements"]:
                self.data["achievements"].append("Первый запуск")
                self.data["coins"] += 50
                self._save_json(DATA_FILE, self.data)
                self.after(0, lambda: self.coin_label.configure(text=f"🪙 {self.data['coins']}"))
                
            self._set_progress(1.0, "✅ Игра запущена!")
            
        except Exception as e:
            self.after(0, lambda: self.progress.stop())
            self.after(0, lambda: self.progress.configure(mode="determinate"))
            self._set_progress(0, f"❌ Ошибка: {e}")
        finally:
            self.after(0, lambda: self.play_btn.configure(state="normal", text="▶  ИГРАТЬ"))

    # ---------- ГЛАВНАЯ СТРАНИЦА ----------
    def _build_home_page(self):
        frame = ctk.CTkFrame(self.container, fg_color="transparent")
        ctk.CTkLabel(frame, text="Добро пожаловать!", font=ctk.CTkFont(size=28, weight="bold"), text_color=TEXT).pack(anchor="w")
        ctk.CTkLabel(frame, text="Выберите загрузчик и версию", font=ctk.CTkFont(size=13), text_color=SUBTEXT).pack(anchor="w", pady=(2, 20))

        card = ctk.CTkFrame(frame, fg_color=PANEL_COLOR, corner_radius=16)
        card.pack(fill="x")
        inner = ctk.CTkFrame(card, fg_color="transparent")
        inner.pack(fill="x", padx=24, pady=20)

        ctk.CTkLabel(inner, text="Никнейм", text_color=TEXT, font=ctk.CTkFont(size=12, weight="bold")).pack(anchor="w")
        self.nick_entry = ctk.CTkEntry(inner, placeholder_text="Введите ник", height=42, corner_radius=10, fg_color="#0e0e15", border_color="#2a2a3a", text_color=TEXT)
        self.nick_entry.pack(fill="x", pady=(6, 16))
        if self.settings.get("nickname"):
            self.nick_entry.insert(0, self.settings["nickname"])

        ctk.CTkLabel(inner, text="Загрузчик", text_color=TEXT, font=ctk.CTkFont(size=12, weight="bold")).pack(anchor="w")
        self.loader_combo = ctk.CTkComboBox(inner, values=["Vanilla", "Forge", "NeoForge", "Fabric"], height=42, corner_radius=10, fg_color="#0e0e15", border_color="#2a2a3a", button_color=ACCENT, text_color=TEXT, command=self._on_loader_change)
        self.loader_combo.pack(fill="x", pady=(6, 16))
        self.loader_combo.set("Vanilla")

        ctk.CTkLabel(inner, text="Версия Minecraft", text_color=TEXT, font=ctk.CTkFont(size=12, weight="bold")).pack(anchor="w")
        self.version_button = ctk.CTkButton(inner, text=f"Выбрать версию ({self.settings.get('version', '1.20.4')})", height=42, corner_radius=10, fg_color="#0e0e15", border_color="#2a2a3a", border_width=1, text_color=TEXT, hover_color="#22222e", command=self._open_version_selector)
        self.version_button.pack(fill="x", pady=(6, 0))

        self.status = ctk.CTkLabel(frame, text="Загрузка версий...", font=ctk.CTkFont(size=12), text_color=SUBTEXT)
        self.status.pack(anchor="w", pady=(16, 4))

        self.progress = ctk.CTkProgressBar(frame, height=8, corner_radius=4, fg_color="#1a1a24", progress_color=ACCENT)
        self.progress.pack(fill="x")
        self.progress.set(0)

        self.play_btn = ctk.CTkButton(frame, text="▶  ИГРАТЬ", height=56, corner_radius=14, font=ctk.CTkFont(size=18, weight="bold"), fg_color=ACCENT, hover_color=ACCENT_HOVER, command=self._play)
        self.play_btn.pack(fill="x", pady=(22, 0))
        
        self.after(500, self._load_versions_async)
        return frame

    def _on_loader_change(self, choice):
        self._selected_loader = choice

    # ---------- ВСПОМОГАТЕЛЬНЫЕ ----------
    def _build_sites_page(self, title, sites):
        frame = ctk.CTkFrame(self.container, fg_color="transparent")
        ctk.CTkLabel(frame, text=title, font=ctk.CTkFont(size=28, weight="bold"), text_color=TEXT).pack(anchor="w", pady=(0, 10))
        card = ctk.CTkFrame(frame, fg_color=PANEL_COLOR, corner_radius=16)
        card.pack(fill="both", expand=True, pady=10)
        scroll = ctk.CTkScrollableFrame(card, fg_color="transparent")
        scroll.pack(fill="both", expand=True, padx=14, pady=(20, 14))
        for name, url in sites:
            ctk.CTkButton(scroll, text=f"🔗 {name}", anchor="w", height=40, corner_radius=10, fg_color="transparent", hover_color="#22222e", text_color=TEXT, command=lambda u=url: webbrowser.open(u)).pack(fill="x", pady=3)
        return frame

    def _build_ingame_page(self):
        frame = ctk.CTkFrame(self.container, fg_color="transparent")
        ctk.CTkLabel(frame, text="⚔ В игре", font=ctk.CTkFont(size=28, weight="bold"), text_color=TEXT).pack(anchor="w", pady=(0, 10))
        scroll = ctk.CTkScrollableFrame(frame, fg_color="transparent")
        scroll.pack(fill="both", expand=True)
        ctk.CTkLabel(scroll, text="Оптимизация:\n• Sodium\n• Lithium\n• FerriteCore\n\nPvP:\n• AppleSkin\n• Armor HUD\n• TotemCounter", font=ctk.CTkFont(size=14), text_color=TEXT, justify="left").pack(anchor="w", padx=20, pady=20)
        return frame


