    def _build_skins_page(self):
        frame = ctk.CTkFrame(self.container, fg_color="transparent")
        ctk.CTkLabel(frame, text="🧑 Скины", font=ctk.CTkFont(size=28, weight="bold"), text_color=TEXT).pack(anchor="w", pady=(0, 10))
        
        card = ctk.CTkFrame(frame, fg_color=PANEL_COLOR, corner_radius=16)
        card.pack(fill="both", expand=True, pady=10, padx=10)
        
        scroll = ctk.CTkScrollableFrame(card, fg_color="transparent")
        scroll.pack(fill="both", expand=True, padx=20, pady=20)
        
        for skin in SKINS_CATALOG:
            s_frame = ctk.CTkFrame(scroll, fg_color="#1a1a24", corner_radius=10)
            s_frame.pack(fill="x", pady=5)
            
            ctk.CTkLabel(s_frame, text=skin["name"], font=ctk.CTkFont(size=14), text_color=TEXT).pack(side="left", padx=15, pady=10)
            
            owned = skin["name"] in self.data.get("owned_skins", [])
