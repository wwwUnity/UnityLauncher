    def _nav(self, parent, text, cmd):
        ctk.CTkButton(parent, text=text, anchor="w", height=36, corner_radius=10, fg_color="transparent", hover_color="#22222e", text_color=TEXT, font=ctk.CTkFont(size=13), command=cmd).pack(fill="x", padx=12, pady=1)

    def _show_page(self, name):
        try:
            for page in self._built_pages.values():
                if page.winfo_ismapped():
                    page.pack_forget()

            if name not in self._built_pages:
                builder = self._page_builders.get(name)
                if not builder:
                    return
                self._built_pages[name] = builder()

            self._built_pages[name].pack(fill="both", expand=True, padx=28, pady=24)
        except Exception:
            self._log_error()

    # ---------- ПРОВЕРКА ОБНОВЛЕНИЙ ----------
    def _check_update_async(self):
        threading.Thread(target=self._check_update, daemon=True).start()

    def _check_update(self):
        try:
            req = urllib.request.Request(UPDATE_URL, headers={'User-Agent': 'Mozilla/5.0'})
            with urllib.request.urlopen(req, timeout=5) as response:
                remote_data = json.loads(response.read().decode())
                remote_version = remote_data.get("version", "0.0.0")
            
            if remote_version != VERSION:
                self.after(0, lambda: self._show_update_dialog(remote_version))
            else:
                self.after(0, lambda: self.status.configure(text="✅ Обновлений нет. У вас последняя версия."))
        except Exception as e:
            self.after(0, lambda: self.status.configure(text=f"❌ Ошибка проверки: {e}"))

    def _show_update_dialog(self, remote_version):
        win = ctk.CTkToplevel(self)
        win.title("Доступно обновление")
        win.geometry("400x200")
        win.configure(fg_color=BG_COLOR)
        win.attributes("-topmost", True)
        
        ctk.CTkLabel(win, text="🔄 Доступно обновление!", font=ctk.CTkFont(size=18, weight="bold"), text_color=TEXT).pack(pady=20)
        ctk.CTkLabel(win, text=f"Ваша версия: {VERSION}\nНовая версия: {remote_version}", text_color=SUBTEXT).pack()
        
        def open_download():
            webbrowser.open("https://github.com/ВАШ_НИК/unity-launcher/releases")
            win.destroy()
        
        ctk.CTkButton(win, text="Скачать", height=40, fg_color=ACCENT, command=open_download).pack(pady=20)

