        card.pack(fill="both", expand=True, pady=10, padx=10)
        
        scroll = ctk.CTkScrollableFrame(card, fg_color="transparent")
        scroll.pack(fill="both", expand=True, padx=20, pady=20)
        
        ctk.CTkLabel(scroll, text="⚠️ Онлайн-статус друзей требует подключения к серверу.\nВ данной версии список друзей локальный.", text_color=SUBTEXT).pack(pady=10)
        
        if not self.data["friends"]:
            ctk.CTkLabel(scroll, text="Список друзей пуст.", text_color=SUBTEXT).pack(pady=20)
        else:
            for friend in self.data["friends"]:
                f_frame = ctk.CTkFrame(scroll, fg_color="#1a1a24", corner_radius=10)
                f_frame.pack(fill="x", pady=5)
                ctk.CTkLabel(f_frame, text=friend, font=ctk.CTkFont(size=14), text_color=TEXT).pack(side="left", padx=15, pady=10)
        
        add_frame = ctk.CTkFrame(frame, fg_color="transparent")
        add_frame.pack(fill="x", pady=10)
        
        friend_entry = ctk.CTkEntry(add_frame, placeholder_text="Ник друга", height=40, corner_radius=10, fg_color="#0e0e15")
        friend_entry.pack(side="left", fill="x", expand=True, padx=(0, 10))
        
        def add_friend():
            name = friend_entry.get().strip()
            if name and name not in self.data["friends"]:
                self.data["friends"].append(name)
                self._save_json(DATA_FILE, self.data)
                friend_entry.delete(0, "end")
                self._show_page("home")
