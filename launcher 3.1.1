    def _show_registration(self):
        if self.settings.get("registered"):
            self._build_layout()
            self._check_update_async()
            return

        reg = ctk.CTkToplevel(self)
        reg.title("Регистрация (Обязательно)")
        reg.geometry("450x480")
        reg.configure(fg_color=BG_COLOR)
        reg.attributes("-topmost", True)
        reg.protocol("WM_DELETE_WINDOW", self.destroy)

        ctk.CTkLabel(reg, text="UNITY LAUNCHER", font=ctk.CTkFont(size=24, weight="bold"), text_color=ACCENT).pack(pady=(30, 5))
        ctk.CTkLabel(reg, text="Без регистрации вход запрещён", font=ctk.CTkFont(size=14), text_color="#e74c3c").pack(pady=(0, 20))

        ctk.CTkLabel(reg, text="Email", text_color=TEXT, font=ctk.CTkFont(size=12, weight="bold")).pack(anchor="w", padx=50)
        email_entry = ctk.CTkEntry(reg, placeholder_text="example@mail.com", height=40, corner_radius=10, fg_color="#0e0e15", border_color="#2a2a3a")
        email_entry.pack(fill="x", padx=50, pady=(5, 10))

        ctk.CTkLabel(reg, text="Код подтверждения", text_color=TEXT, font=ctk.CTkFont(size=12, weight="bold")).pack(anchor="w", padx=50)
        
        code_frame = ctk.CTkFrame(reg, fg_color="transparent")
        code_frame.pack(fill="x", padx=50, pady=(5, 15))
        
        code_entry = ctk.CTkEntry(code_frame, placeholder_text="6 цифр", height=40, corner_radius=10, fg_color="#0e0e15", border_color="#2a2a3a")
        code_entry.pack(side="left", fill="x", expand=True, padx=(0, 10))

        def send_code():
            email = email_entry.get().strip()
            if "@" not in email:
                status.configure(text="⚠ Введите корректный email", text_color="#e74c3c")
                return
            
            self._email_code = ''.join(random.choices(string.digits, k=6))
            self._email_target = email
            
            def _send():
                try:
                    msg = EmailMessage()
                    msg.set_content(f"Ваш код подтверждения для UnityLauncher: {self._email_code}")
                    msg["Subject"] = "UnityLauncher - Код"
                    msg["From"] = SMTP_USER
                    msg["To"] = email
                    
                    with smtplib.SMTP(SMTP_SERVER, SMTP_PORT) as server:
                        server.starttls()
                        server.login(SMTP_USER, SMTP_PASSWORD)
                        server.send_message(msg)
                    
                    self.after(0, lambda: status.configure(text="✅ Код отправлен на почту", text_color="#2ecc71"))
                except Exception as e:
                    self.after(0, lambda: status.configure(text=f"❌ Ошибка: {e}", text_color="#e74c3c"))
            
            threading.Thread(target=_send, daemon=True).start()
            status.configure(text="Отправка...", text_color=SUBTEXT)

        ctk.CTkButton(code_frame, text="Отправить", width=100, height=40, corner_radius=10, fg_color=ACCENT, command=send_code).pack(side="right")

        status = ctk.CTkLabel(reg, text="", text_color=SUBTEXT, font=ctk.CTkFont(size=11))
        status.pack()

        def do_register():
            email = email_entry.get().strip()
            code = code_entry.get().strip()
            
            if not self._email_code or code != self._email_code:
                status.configure(text="⚠ Неверный код", text_color="#e74c3c")
                return
            if email != self._email_target:
                status.configure(text="⚠ Email не совпадает", text_color="#e74c3c")
                return
                
            self.settings["nickname"] = email.split("@")[0]
            self.settings["registered"] = True
            self.settings["email"] = email
            self._save_json(SETTINGS_FILE, self.settings)
            reg.destroy()
            self._build_layout()
            self._check_update_async()

        ctk.CTkButton(reg, text="Зарегистрироваться", height=45, corner_radius=10, fg_color=ACCENT, command=do_register).pack(fill="x", padx=50, pady=(20, 10))

    # ---------- НАСТРОЙКИ / ТЕМЫ ----------
    def _apply_theme_from_settings(self):
        global ACCENT, ACCENT_HOVER
        custom = self.settings.get("custom_accent")
        if custom:
            ACCENT = custom
        else:
            name = self.settings.get("theme", "Фиолетовая")
            if name in THEMES:
                ACCENT = THEMES[name]
        ACCENT_HOVER = self._lighten(ACCENT, 0.2)

    def _lighten(self, hex_color, amount=0.2):
        hex_color = hex_color.lstrip("#")
        r, g, b = int(hex_color[0:2], 16), int(hex_color[2:4], 16), int(hex_color[4:6], 16)
        r, g, b = min(255, int(r + (255 - r) * amount)), min(255, int(g + (255 - g) * amount)), min(255, int(b + (255 - b) * amount))
        return f"#{r:02x}{g:02x}{b:02x}"

