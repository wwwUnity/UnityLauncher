            if owned:
                ctk.CTkLabel(s_frame, text="✅ Куплено", text_color="#2ecc71").pack(side="right", padx=15)
            else:
                def buy(s=skin):
                    if self.data["coins"] >= s["price"]:
                        self.data["coins"] -= s["price"]
                        self.data["owned_skins"].append(s["name"])
                        self._save_json(DATA_FILE, self.data)
                        self.coin_label.configure(text=f"🪙 {self.data['coins']}")
                        self._show_page("home")
                        self._show_page("skins")
